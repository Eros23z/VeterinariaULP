@model VeterinariaULP.Models.Mascota

@{
    ViewData["Title"] = "Registrar Mascota";
}

<h2>Registrar Nuevo Paciente</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Salem, Thor..." autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdEspecie" class="form-label fw-bold"></label>
                    <select asp-for="IdEspecie" class="form-select" asp-items="ViewBag.IdEspecie">
                        <option value="">-- Seleccionar Especie --</option>
                    </select>
                    <span asp-validation-for="IdEspecie" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Raza" class="form-label fw-bold"></label>
                    <input asp-for="Raza" class="form-control" placeholder="Ej: Mestizo, Siamés..." />
                    <span asp-validation-for="Raza" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Sexo" class="form-label fw-bold"></label>
                    <select asp-for="Sexo" class="form-select">
                        <option value="Macho">Macho</option>
                        <option value="Hembra">Hembra</option>
                    </select>
                    <span asp-validation-for="Sexo" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="FechaNacimiento" class="form-label fw-bold"></label>
                    <input asp-for="FechaNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>
            </div>

            <!-- SELECTOR ASÍNCRONO DE DUEÑO (REQUERIMIENTO OBLIGATORIO) -->
            <div class="card p-3 mb-3 bg-light border-primary">
                <label class="form-label fw-bold text-primary">
                    <i class="bi bi-search"></i> Asignar Dueño (Búsqueda Asíncrona AJAX):
                </label>
                <input type="hidden" asp-for="IdDueño" id="idDueñoInput" />
                <div class="position-relative">
                    <input type="text" id="buscarDuenoInput" class="form-control" placeholder="Escriba DNI, apellido o nombre del dueño..." autocomplete="off" />
                    <ul id="listaResultadosDueños" class="list-group position-absolute w-100 shadow" style="display:none; z-index: 1050; max-height: 200px; overflow-y: auto;"></ul>
                </div>
                <span asp-validation-for="IdDueño" class="text-danger"></span>

                <div id="dueñoSeleccionadoInfo" class="mt-2 text-success fw-bold" style="display:none;">
                    Dueño seleccionado: <span id="lblDueñoSeleccionado"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Foto del Paciente:</label>
                    <input type="file" name="fotoFile" accept="image/*" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Observaciones" class="form-label fw-bold"></label>
                    <input asp-for="Observaciones" class="form-control" placeholder="Alergias, conducta, antecedentes..." />
                </div>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Activo" />
                <label class="form-check-label" asp-for="Activo">Paciente Activo</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Registrar Mascota</button>
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const inputBuscar = document.getElementById('buscarDuenoInput');
        const listaResultados = document.getElementById('listaResultadosDueños');
        const inputHidden = document.getElementById('idDueñoInput');
        const infoDiv = document.getElementById('dueñoSeleccionadoInfo');
        const lblDueño = document.getElementById('lblDueñoSeleccionado');

        let timeout = null;

        inputBuscar.addEventListener('input', function () {
            clearTimeout(timeout);
            const query = this.value.trim();

            if (query.length < 2) {
                listaResultados.style.display = 'none';
                return;
            }

            timeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/Dueños/BuscarAjax?q=${encodeURIComponent(query)}`);
                    const data = await res.json();
                    listaResultados.innerHTML = '';

                    if (data.length === 0) {
                        listaResultados.innerHTML = '<li class="list-group-item text-muted">No se encontraron dueños con ese criterio.</li>';
                    } else {
                        data.forEach(d => {
                            const li = document.createElement('li');
                            li.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center cursor-pointer';
                            li.style.cursor = 'pointer';
                            li.innerHTML = `<strong>${d.nombreCompleto}</strong> <span class="badge bg-secondary">DNI: ${d.dni}</span>`;
                            li.addEventListener('click', () => {
                                inputHidden.value = d.idDueño;
                                lblDueño.textContent = `${d.nombreCompleto} (DNI: ${d.dni})`;
                                infoDiv.style.display = 'block';
                                listaResultados.style.display = 'none';
                                inputBuscar.value = '';
                            });
                            listaResultados.appendChild(li);
                        });
                    }
                    listaResultados.style.display = 'block';
                } catch (e) {
                    console.error("Error al buscar dueños vía AJAX", e);
                }
            }, 300);
        });

        document.addEventListener('click', function (e) {
            if (!inputBuscar.contains(e.target) && !listaResultados.contains(e.target)) {
                listaResultados.style.display = 'none';
            }
        });
    </script>
}