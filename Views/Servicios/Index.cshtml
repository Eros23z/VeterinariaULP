@{
    ViewData["Title"] = "Gestión de Servicios Médicos";
}

<div id="appServicios" v-cloak>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2><i class="bi bi-briefcase"></i> Servicios y Aranceles Médicos</h2>
            <p class="text-muted mb-0">Módulo SPA reactivo desarrollado en Vue 3 con operaciones asíncronas vía Fetch API.</p>
        </div>
        <button class="btn btn-primary" @@click="abrirModalCrear">
            <i class="bi bi-plus-circle"></i> Nuevo Servicio
        </button>
    </div>

    <!-- Alertas reactivas de éxito y error -->
    <div v-if="mensajeExito" class="alert alert-success alert-dismissible fade show" role="alert">
        {{ mensajeExito }}
        <button type="button" class="btn-close" @@click="mensajeExito = ''"></button>
    </div>
    <div v-if="mensajeError" class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ mensajeError }}
        <button type="button" class="btn-close" @@click="mensajeError = ''"></button>
    </div>

    <!-- Buscador en tiempo real sobre el Virtual DOM -->
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" v-model="filtro" class="form-control" placeholder="Filtrar servicios por descripción en tiempo real..." />
        </div>
        <div class="col-md-2" v-if="filtro">
            <button class="btn btn-outline-secondary w-100" @@click="filtro = ''">Limpiar Filtro</button>
        </div>
    </div>

    <!-- Spinner de carga -->
    <div v-if="cargando" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-2">Cargando catálogo de prestaciones...</p>
    </div>

    <!-- Tabla Reactiva -->
    <div v-else class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Precio Base</th>
                    <th>Duración Estimada</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="serviciosFiltrados.length === 0">
                    <td colspan="6" class="text-center py-4 text-muted">No se registran servicios acordes al criterio de búsqueda.</td>
                </tr>
                <tr v-for="item in serviciosFiltrados" :key="item.idServicio">
                    <td><strong>#{{ item.idServicio }}</strong></td>
                    <td>{{ item.descripcion }}</td>
                    <td><strong>${{ formatoMoneda(item.precioBase) }}</strong></td>
                    <td><i class="bi bi-clock"></i> {{ item.duracionMinutos }} min</td>
                    <td>
                        <span class="badge" :class="item.activo ? 'bg-success' : 'bg-secondary'">
                            {{ item.activo ? 'Disponible' : 'Inactivo' }}
                        </span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-warning me-1" @@click="abrirModalEditar(item)">
                            <i class="bi bi-pencil"></i> Editar
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @@click="eliminarServicio(item)">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- MODAL BOOTSTRAP CONTROLADO POR VUE -->
    <div class="modal fade" id="modalServicio" tabindex="-1" aria-hidden="true" ref="modalElemento">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" :class="modoEdicion ? 'bg-warning text-dark' : 'bg-primary text-white'">
                    <h5 class="modal-title">{{ modoEdicion ? 'Editar Servicio #' + actual.idServicio : 'Registrar Nuevo Servicio' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <!-- Errores de validación backend -->
                    <div v-if="erroresModal.length > 0" class="alert alert-danger py-2">
                        <ul class="mb-0 ps-3">
                            <li v-for="err in erroresModal" :key="err">{{ err }}</li>
                        </ul>
                    </div>

                    <form @@submit.prevent="guardarServicio">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción:</label>
                            <input type="text" v-model="actual.descripcion" class="form-control" required placeholder="Ej: Ecografía abdominal..." />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Precio Base ($):</label>
                                <input type="number" step="0.01" min="0.01" v-model.number="actual.precioBase" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Duración (Minutos):</label>
                                <input type="number" min="5" max="480" v-model.number="actual.duracionMinutos" class="form-control" required />
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" v-model="actual.activo" id="checkActivo" />
                            <label class="form-check-label" for="checkActivo">Servicio Habilitado para Turnos</label>
                        </div>

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn" :class="modoEdicion ? 'btn-warning' : 'btn-primary'">
                                {{ modoEdicion ? 'Actualizar Cambios' : 'Crear Prestación' }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN Oficial de Vue 3 según diapositiva de clase -->
    <script src="https://unpkg.com/vue@3"></script>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    servicios: [],
                    filtro: '',
                    cargando: false,
                    mensajeExito: '',
                    mensajeError: '',
                    erroresModal: [],
                    modoEdicion: false,
                    modalInstance: null,
                    actual: {
                        idServicio: 0,
                        descripcion: '',
                        precioBase: 0,
                        duracionMinutos: 30,
                        activo: true
                    }
                };
            },
            computed: {
                serviciosFiltrados() {
                    if (!this.filtro.trim()) return this.servicios;
                    const q = this.filtro.toLowerCase();
                    return this.servicios.filter(s => s.descripcion.toLowerCase().includes(q));
                }
            },
            mounted() {
                this.modalInstance = new bootstrap.Modal(this.$refs.modalElemento);
                this.cargarServicios();
            },
            methods: {
                async cargarServicios() {
                    this.cargando = true;
                    try {
                        const res = await fetch('/Servicios/ListarJson');
                        if (res.ok) {
                            this.servicios = await res.json();
                        } else {
                            this.mensajeError = "No se pudo sincronizar el catálogo de servicios.";
                        }
                    } catch (e) {
                        this.mensajeError = "Error de red al consultar el servidor.";
                    } finally {
                        this.cargando = false;
                    }
                },
                abrirModalCrear() {
                    this.modoEdicion = false;
                    this.erroresModal = [];
                    this.actual = {
                        idServicio: 0,
                        descripcion: '',
                        precioBase: 15000,
                        duracionMinutos: 30,
                        activo: true
                    };
                    this.modalInstance.show();
                },
                abrirModalEditar(item) {
                    this.modoEdicion = true;
                    this.erroresModal = [];
                    this.actual = { ...item };
                    this.modalInstance.show();
                },
                async guardarServicio() {
                    this.erroresModal = [];
                    const url = this.modoEdicion ? '/Servicios/ModificarJson' : '/Servicios/CrearJson';

                    try {
                        const res = await fetch(url, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.actual)
                        });

                        const data = await res.json();

                        if (res.ok) {
                            this.modalInstance.hide();
                            this.mensajeExito = this.modoEdicion ? "Servicio actualizado correctamente." : "Servicio creado con éxito.";
                            this.cargarServicios();
                        } else {
                            if (data.errores) {
                                this.erroresModal = data.errores;
                            } else if (data.mensaje) {
                                this.erroresModal = [data.mensaje];
                            }
                        }
                    } catch (err) {
                        this.erroresModal = ["Ocurrió un error inesperado al procesar la solicitud."];
                    }
                },
                async eliminarServicio(item) {
                    if (!confirm(`¿Confirma la eliminación del servicio '${item.descripcion}'?`)) return;

                    try {
                        const res = await fetch(`/Servicios/EliminarJson/${item.idServicio}`, {
                            method: 'POST'
                        });

                        const data = await res.json();

                        if (res.ok) {
                            this.mensajeExito = data.mensaje;
                            this.cargarServicios();
                        } else {
                            this.mensajeError = data.mensaje || "No se pudo eliminar el servicio seleccionado.";
                        }
                    } catch (err) {
                        this.mensajeError = "Error de conexión al intentar borrar el registro.";
                    }
                },
                formatoMoneda(val) {
                    return Number(val).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            }
        }).mount('#appServicios');
    </script>

    <style>
        [v-cloak] {
            display: none;
        }
    </style>
}