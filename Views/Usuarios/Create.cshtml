@model VeterinariaULP.Models.Usuario

@{
    ViewData["Title"] = "Nuevo Personal";
}

<h2><i class="bi bi-person-plus"></i> Registrar Personal</h2>
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" required autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellido" class="form-label fw-bold"></label>
                    <input asp-for="Apellido" class="form-control" required />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" type="email" class="form-control" required placeholder="profesional@vetpoint.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Clave" class="form-label fw-bold"></label>
                    <input asp-for="Clave" type="password" class="form-control" required placeholder="••••••••" />
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Rol" class="form-label fw-bold"></label>
                    <select asp-for="Rol" class="form-select">
                        <option value="Veterinario">Veterinario</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                    <span asp-validation-for="Rol" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Matricula" class="form-label fw-bold"></label>
                    <input asp-for="Matricula" class="form-control" placeholder="Ej: MP-7890" />
                    <span asp-validation-for="Matricula" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Estado" />
                <label class="form-check-label" asp-for="Estado">Usuario Activo</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Registrar Usuario</button>
                <a asp-action="Index" class="btn btn-secondary">Volver al Personal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}