@model VeterinariaULP.Models.Turno

@{
    ViewData["Title"] = "Agendar Turno";
}

<h2>Agendar Cita Médica</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- BLOQUE DE BÚSQUEDA Y SELECCIÓN ASÍNCRONA -->
            <div class="card p-3 mb-3 bg-light border-primary">
                <h5 class="card-title text-primary"><i class="bi bi-search"></i> 1. Selección de Paciente (Búsqueda Asíncrona)</h5>
                
                @if (ViewBag.MascotaPreseleccionada != null)
                {
                    <div class="alert alert-success py-2 mb-2">
                        Paciente preseleccionado: <strong>@ViewBag.MascotaPreseleccionada</strong>
                    </div>
                }

                <div class="position-relative mb-2">
                    <input type="text" id="buscarDuenoInput" class="form-control" placeholder="Buscar dueño por DNI, Apellido o Nombre..." autocomplete="off" />
                    <ul id="listaDueños" class="list-group position-absolute w-100 shadow" style="display:none; z-index: 1050; max-height: 180px; overflow-y:auto;"></ul>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Seleccionar Mascota del Dueño:</label>
                        <select asp-for="IdMascota" class="form-select" id="selectMascota">
                            <option value="">-- Primero seleccione o busque un dueño arriba --</option>
                            @if (Model.IdMascota > 0)
                            {
                                <option value="@Model.IdMascota" selected>@ViewBag.MascotaPreseleccionada</option>
                            }
                        </select>
                        <span asp-validation-for="IdMascota" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card p-3 mb-3 shadow-sm">
                <h5 class="card-title"><i class="bi bi-calendar3"></i> 2. Datos de la Cita Médica</h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="FechaHora" class="form-label fw-bold"></label>
                        <input asp-for="FechaHora" class="form-control" type="datetime-local" />
                        <span asp-validation-for="FechaHora" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdServicio" class="form-label fw-bold"></label>
                        <select asp-for="IdServicio" class="form-select" asp-items="ViewBag.IdServicio">
                            <option value="">-- Seleccionar Prestación --</option>
                        </select>
                        <span asp-validation-for="IdServicio" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="IdVeterinario" class="form-label fw-bold"></label>
                        <select asp-for="IdVeterinario" class="form-select" asp-items="ViewBag.IdVeterinario"></select>
                        <span asp-validation-for="IdVeterinario" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Estado" class="form-label fw-bold"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Atendido">Atendido</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Motivo" class="form-label fw-bold"></label>
                    <textarea asp-for="Motivo" class="form-control" rows="2" placeholder="Síntomas observados o motivo de consulta..."></textarea>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Confirmar y Agendar</button>
                <a asp-action="Index" class="btn btn-secondary">Volver a la Agenda</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const inputBuscar = document.getElementById('buscarDuenoInput');
        const listaDueños = document.getElementById('listaDueños');
        const selectMascota = document.getElementById('selectMascota');
        let timeout = null;

        inputBuscar.addEventListener('input', function () {
            clearTimeout(timeout);
            const query = this.value.trim();
            if (query.length < 2) { listaDueños.style.display = 'none'; return; }

            timeout = setTimeout(async () => {
                const res = await fetch(`/Dueños/BuscarAjax?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                listaDueños.innerHTML = '';

                if (data.length === 0) {
                    listaDueños.innerHTML = '<li class="list-group-item text-muted">Sin coincidencias.</li>';
                } else {
                    data.forEach(d => {
                        const li = document.createElement('li');
                        li.className = 'list-group-item list-group-item-action cursor-pointer';
                        li.style.cursor = 'pointer';
                        li.innerHTML = `<strong>${d.nombreCompleto}</strong> (DNI: ${d.dni})`;
                        li.addEventListener('click', async () => {
                            inputBuscar.value = d.nombreCompleto;
                            listaDueños.style.display = 'none';
                            await cargarMascotasDeDueño(d.idDueño);
                        });
                        listaDueños.appendChild(li);
                    });
                }
                listaDueños.style.display = 'block';
            }, 300);
        });

        async function cargarMascotasDeDueño(idDueño) {
            selectMascota.innerHTML = '<option value="">Cargando mascotas...</option>';
            try {
                const res = await fetch(`/Mascotas/PorDueñoJson?idDueño=${idDueño}`);
                const data = await res.json();
                selectMascota.innerHTML = '<option value="">-- Seleccionar Mascota --</option>';
                if (data.length === 0) {
                    selectMascota.innerHTML = '<option value="">(El dueño no tiene mascotas activas)</option>';
                } else {
                    data.forEach(m => {
                        const opt = document.createElement('option');
                        opt.value = m.idMascota;
                        opt.textContent = `${m.nombre} (${m.raza})`;
                        selectMascota.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error(err);
                selectMascota.innerHTML = '<option value="">Error al cargar pacientes</option>';
            }
        }

        document.addEventListener('click', (e) => {
            if (!inputBuscar.contains(e.target) && !listaDueños.contains(e.target)) {
                listaDueños.style.display = 'none';
            }
        });
    </script>
}