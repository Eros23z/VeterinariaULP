@model VeterinariaULP.Models.Pago

@{
    ViewData["Title"] = "Comprobante de Pago";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Comprobante de Cobro #@Model.IdPago</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>
<hr />

<div class="card shadow-sm col-md-6 border-@(Model.Anulado ? "danger" : "dark")">
    <div class="card-header bg-@(Model.Anulado ? "danger" : "dark") text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Recibo Oficial VetPoint</h5>
        <span class="badge @(Model.Anulado ? "bg-light text-danger" : "bg-success")">
            @(Model.Anulado ? "COMPROBANTE ANULADO" : "PAGO ACREDITADO")
        </span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Fecha y Hora:</dt>
            <dd class="col-sm-8">@Model.FechaPago.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Concepto:</dt>
            <dd class="col-sm-8">@Model.Concepto</dd>

            <dt class="col-sm-4">Medio de Pago:</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.MetodoPago</span></dd>

            <dt class="col-sm-4">Total Cobrado:</dt>
            <dd class="col-sm-8"><span class="h4 text-success fw-bold">$@Model.Importe.ToString("N2")</span></dd>

            <dt class="col-sm-4">Paciente:</dt>
            <dd class="col-sm-8">@Model.Atencion?.Turno?.Mascota?.Nombre (@Model.Atencion?.Turno?.Mascota?.Dueño?.NombreCompleto)</dd>

            <dt class="col-sm-4">Ficha Médica:</dt>
            <dd class="col-sm-8">
                <a asp-controller="Atenciones" asp-action="Details" asp-route-id="@Model.IdAtencion">
                    Ver Atención Clínica #@Model.IdAtencion
                </a>
            </dd>

            <dt class="col-sm-4">Operador:</dt>
            <dd class="col-sm-8">@Model.UsuarioCrea?.NombreCompleto</dd>
        </dl>
    </div>
</div>