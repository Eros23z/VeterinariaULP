@model IEnumerable<VeterinariaULP.Models.Pago>

@{
    ViewData["Title"] = "Gestión de Cobros";
    decimal total = ViewBag.TotalRecaudado ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2><i class="bi bi-cash-stack"></i> Transacciones y Cobros</h2>
        <h6 class="text-muted mb-0">Total Recaudado (Activo): <strong class="text-success">$@total.ToString("N2")</strong></h6>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3 bg-light p-3 rounded shadow-sm">
    <div class="col-md-5">
        <input type="text" name="search" class="form-control" placeholder="Buscar por concepto, paciente o dueño (DNI)..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-3">
        <select name="metodoPago" class="form-select">
            <option value="">-- Todos los Medios de Pago --</option>
            <option value="Efectivo" selected="@(ViewBag.MetodoPago == "Efectivo")">Efectivo</option>
            <option value="Transferencia" selected="@(ViewBag.MetodoPago == "Transferencia")">Transferencia</option>
            <option value="Tarjeta" selected="@(ViewBag.MetodoPago == "Tarjeta")">Tarjeta</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-outline-danger w-100">Limpiar</a>
    </div>
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Fecha</th>
                <th>Concepto</th>
                <th>Paciente / Dueño</th>
                <th>Medio</th>
                <th>Importe</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No se registran pagos en el sistema.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr class="@(item.Anulado ? "table-danger text-muted text-decoration-line-through" : "")">
                        <td><strong>#@item.IdPago</strong></td>
                        <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Concepto</td>
                        <td>
                            @item.Atencion?.Turno?.Mascota?.Nombre
                            <small class="d-block text-muted">(@item.Atencion?.Turno?.Mascota?.Dueño?.Apellido)</small>
                        </td>
                        <td><span class="badge bg-secondary">@item.MetodoPago</span></td>
                        <td><strong>$@item.Importe.ToString("N2")</strong></td>
                        <td>
                            @if (item.Anulado)
                            {
                                <span class="badge bg-danger">ANULADO</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Acreditado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.IdPago" class="btn btn-sm btn-outline-info">Recibo</a>
                            @if (!item.Anulado)
                            {
                                <form asp-action="Anular" asp-route-id="@item.IdPago" method="post" class="d-inline" onsubmit="return confirm('¿Confirma la anulación lógica de esta transacción?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Anular</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" />