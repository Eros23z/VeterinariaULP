@model VeterinariaULP.Models.Dueño

@{
    ViewData["Title"] = "Eliminar Dueño";
}

<h2 class="text-danger">Eliminar Dueño</h2>
<h5>¿Estás seguro de que deseas eliminar este registro?</h5>
<hr />

<div class="card border-danger shadow-sm col-md-6 mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">DNI</dt>
            <dd class="col-sm-8"><strong>@Model.Dni</strong></dd>

            <dt class="col-sm-4">Apellido y Nombre</dt>
            <dd class="col-sm-8">@Model.NombreCompleto</dd>

            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@Model.Direccion</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.IdDueño" method="post">
    <input type="hidden" name="id" value="@Model.IdDueño" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>