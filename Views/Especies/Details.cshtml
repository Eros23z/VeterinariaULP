@model VeterinariaULP.Models.Especie

@{
    ViewData["Title"] = "Detalle de Especie";
}

<h2>Detalle de Categoría</h2>
<hr />

<div class="card shadow-sm col-md-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IdEspecie)</dt>
            <dd class="col-sm-8">#@Model.IdEspecie</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.IdEspecie" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>