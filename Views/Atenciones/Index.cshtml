@model IEnumerable<VeterinariaULP.Models.AtencionClinica>

@{
    ViewData["Title"] = "Historial de Atenciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard2-pulse"></i> Consultas y Atenciones Clínicas</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3 bg-light p-3 rounded shadow-sm">
    <div class="col-md-5">
        <input type="text" name="search" class="form-control" placeholder="Buscar por paciente, dueño o diagnóstico..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Buscar</button>
    </div>
    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
    {
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-danger w-100">Limpiar</a>
        </div>
    }
</form>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Fecha</th>
                <th>Paciente</th>
                <th>Dueño</th>
                <th>Prestación</th>
                <th>Diagnóstico Resumido</th>
                <th>Estudio Adjunto</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">No se registran atenciones clínicas efectuadas.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.IdAtencion</strong></td>
                        <td>@item.FechaAtencion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <strong>@item.Turno?.Mascota?.Nombre</strong>
                            <small class="d-block text-muted">(@item.PesoActual kg)</small>
                        </td>
                        <td>@item.Turno?.Mascota?.Dueño?.NombreCompleto</td>
                        <td>@item.Turno?.Servicio?.Descripcion</td>
                        <td>@item.Diagnostico</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ArchivoEstudio))
                            {
                                <a href="@item.ArchivoEstudio" target="_blank" class="badge bg-primary text-decoration-none">
                                    <i class="bi bi-paperclip"></i> Ver Estudio
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Sin Archivos</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.IdAtencion" class="btn btn-sm btn-outline-info">Ficha</a>
                            <a asp-action="HistorialMascota" asp-route-id="@item.Turno?.IdMascota" class="btn btn-sm btn-outline-secondary">Historial</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" />